%{ for site in ["site_a", "site_b"] ~}
[${site}]
%{ for name, h in hosts ~}
%{ if h.site == site ~}
${name} ansible_host=${h.ip} ansible_user=${h.user}
%{ endif ~}
%{ endfor ~}

%{ endfor ~}
[routers]
%{ for r in routers ~}
${r}
%{ endfor ~}

[all:vars]
ansible_ssh_private_key_file=~/.ssh/id_ed25519
