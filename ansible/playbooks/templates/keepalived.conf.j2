global_defs {
  enable_script_security
  script_user root
}

vrrp_script chk_k3s {
  script "/usr/bin/systemctl is-active --quiet k3s"
  interval 5
  fall 2
  rise 2
}

vrrp_instance VI_1 {
  state {{ vrrp_state }}
  interface {{ vrrp_if }}
  virtual_router_id 51
  priority {{ vrrp_prio }}
  advert_int 1
  unicast_src_ip {{ ansible_host }}
  unicast_peer {
{% for h in groups["all"] if h != inventory_hostname %}
    {{ hostvars[h].ansible_host }}
{% endfor %}
  }
  authentication {
    auth_type PASS
    auth_pass {{ vrrp_pass }}
  }
  virtual_ipaddress {
    192.168.16.100/24
  }
  track_script {
    chk_k3s
  }
}
